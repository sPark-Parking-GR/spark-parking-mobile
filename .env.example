EXPO_PUBLIC_AUTH_PROVIDER=firebase   # firebase | clerk

# Firebase
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=

# Clerk
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Maps
EXPO_PUBLIC_MAP_PROVIDER=google      # google | mapbox
# Required for the native renderer: Google Maps draws via react-native-maps (provider=GOOGLE, iOS+Android).
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=

# Map renderer: webview (Leaflet/OSM, keyless, Expo Go) | native (react-native-maps, dev build)
# Unset -> webview in dev, native in production build.
EXPO_PUBLIC_MAP_RENDERER=webview

# API
# iOS simulator: localhost works. Android emulator: use http://10.0.2.2:3001/api/v1
# Physical device (Expo Go): use your machine LAN IP, e.g. http://192.168.1.10:3001/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
