{
  "name": "spark-mobile",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "main": "expo-router/entry",
  "scripts": {
    "prebuild": "expo prebuild --clean",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "eas-build": "npx eas-cli build --profile development --platform android",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "7.3.3",
    "@stripe/stripe-react-native": "0.64.0",
    "babel-preset-expo": "~57.0.10",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-navigation/bottom-tabs": "7.18.13",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-universe": "^13.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@react-navigation/bottom-tabs": "7.18.13",
      "@react-navigation/elements": "2.9.40",
      "@react-navigation/native": "7.3.3",
      "baseline-browser-mapping": "2.11.24",
      "is-core-module": "2.16.1",
      "node-releases": "2.0.55",
      "typed-array-byte-offset": "1.0.4",
      "which-typed-array": "1.1.22"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react-dom"
      ]
    }
  }
}
