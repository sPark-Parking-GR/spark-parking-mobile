{
  "expo": {
    "name": "Parqin",
    "slug": "parqin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "parqin",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f9f8f6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.parqin.app"
    },
    "android": {
      "package": "com.parqin.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f9f8f6"
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Το Parqin χρησιμοποιεί την τοποθεσία σου για να βρει χώρους στάθμευσης κοντά σου."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
